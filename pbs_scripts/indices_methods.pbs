#!/bin/bash
#PBS -N indices_methods
#PBS -l mem=4GB
#PBS -l ncpus=1
#PBS -l jobfs=1GB
#PBS -P xe2
#PBS -l walltime=10:00:00
#PBS -l storage=gdata/xe2+gdata/ob53+scratch/xe2
#PBS -q normal

# Parameterised multi-method indices runner. Pass via `qsub -v`:
#   folder=<dir of expanded tifs>  outdir=<output dir>  param_stub=<stub>  method=<one of the 2 below>
# These 2 methods bracket the GCH default (gch_region.pbs: WINDWARD, edge_size 4), giving a
# sensitivity range of edge_size 3/4/5 and min_core_size 500/1000/2000.
# All include --opportunities. The wind method needs BARRA (gdata/ob53) and emits
# shelter_distances.tif; the percent method emits shelter_densities.tif.
#
# COST / WALLTIME (measured on the 2025 ag full-run, 10m tiles):
#   per-tile SU — less_percent 0.0023, more_wind (now WINDWARD, not ANY) ~0.004.
#   Both finish comfortably within this 10h walltime even for the largest ~2500-tile regions
#   (~6-9 SU each). NB: the old more_windmethod used wind_method ANY (8 directions), which was
#   ~2-3x costlier and timed out on regions above ~1800 tiles; with WINDWARD that no longer applies.

export GDAL_CACHEMAX=64
export GDAL_NUM_THREADS=1

cd /home/147/cb8590/Projects/shelterbelts/src/shelterbelts/indices
source /g/data/xe2/cb8590/miniconda/etc/profile.d/conda.sh
conda activate /g/data/xe2/cb8590/miniconda/envs/shelterbelts
tmpdir="$PBS_JOBFS"

case "$method" in
  less_percentmethod)    method_args="--cover_threshold 50 --crop_pixels 20 --buffer_width 3 --max_shelterbelt_width 5 --min_shelterbelt_length 25 --min_patch_size 25 --edge_size 3 --density_threshold 10 --min_core_size 500" ;;
  more_windmethod)       method_args="--cover_threshold 50 --crop_pixels 20 --wind_method WINDWARD --buffer_width 5 --max_shelterbelt_width 7 --min_shelterbelt_length 15 --min_patch_size 15 --edge_size 5 --min_core_size 2000 --wind_threshold 15" ;;
  *) echo "Unknown or missing method: '$method'"; exit 1 ;;
esac

echo "indices_methods.pbs: folder=$folder outdir=$outdir param_stub=$param_stub method=$method"
echo "method_args: $method_args"
mkdir -p "$outdir"
python all_indices.py "$folder" --outdir "$outdir" --tmpdir "$tmpdir" --param_stub "$param_stub" $method_args --opportunities

#!/bin/bash
# GCH v2 ag indices, "final app" method set — one ~200 km region, one method, end to end:
# cut 4 km GCH percent(+height) tiles from the binned mosaic, run the indices pipeline with that
# method's thresholds, merge only the region rasters that method needs, combine patch_metrics CSVs
# + centreline gpkgs, then (optionally) delete per-tile intermediates.
#
# 4 methods, edge_size 3/4/5 and min_core_size 500/1000/2000 = low/default/high:
#   less_windmethod       — MOST_COMMON, edge_size 3, min_core_size 500,  height-aware -> shelter_categories.tif
#   default_windmethod    — WINDWARD,    edge_size 4, min_core_size 1000, height-aware -> shelter_categories.tif
#                            + shelter_distances.tif + opportunities.tif (categories layer per
#                            method, plus the distance/opportunity detail on just the default
#                            method — 6 layers total across the 4 methods)
#   more_windmethod        — WINDWARD,    edge_size 5, min_core_size 2000, no height     -> shelter_categories.tif
#   default_percentmethod  — no wind, density-based shelter, no height                   -> shelter_categories.tif
# cover_threshold 1 and crop_pixels 50 match gch_region.pbs (crop MUST equal the cut overlap_px=50,
# otherwise merged regions keep a 30 px overlap collar).
#
# Requires phase-1 binning (gch_bin) already populated $BASE/binned.
# Submit via gch_region_methods.sh, or directly:
#   qsub -v region=lat_34_lon_148,method=less_windmethod,cleanup=1 gch_region_methods.pbs
#PBS -N gch_region_methods
#PBS -l mem=4GB
#PBS -l ncpus=1
#PBS -l jobfs=4GB
#PBS -P xe2
#PBS -l walltime=20:00:00
#PBS -l storage=gdata/xe2+gdata/ob53+scratch/xe2
#PBS -q normal

set -e
export GDAL_CACHEMAX=64
export GDAL_NUM_THREADS=1

source /g/data/xe2/cb8590/miniconda/etc/profile.d/conda.sh
conda activate /g/data/xe2/cb8590/miniconda/envs/shelterbelts
ANALYSIS=/home/147/cb8590/Projects/shelterbelts/analysis
INDICES=/home/147/cb8590/Projects/shelterbelts/src/shelterbelts/indices
CLASSIF=/home/147/cb8590/Projects/shelterbelts/src/shelterbelts/classifications

# height=1 -> cut+run with height_dir (shelter distance in tree heights); opportunities=1 -> also
# run the (extra-cost) planting-opportunities step; merge_suffixes -> which per-tile outputs get
# assembled into a region tif (and later masked/uploaded). Per-tile compute always writes
# shelter_categories.tif alongside shelter_distances/densities.tif (shelter_categories() saves both
# in one call) — merge_suffixes only controls what gets kept at region scale.
case "$method" in
  less_windmethod)
    method_args="--wind_method MOST_COMMON --buffer_width 3 --max_shelterbelt_width 5 --min_shelterbelt_length 25 --min_patch_size 25 --edge_size 3 --density_threshold 10 --min_core_size 500 --wind_threshold 25"
    height=1; opportunities=0; merge_suffixes="_shelter_categories.tif" ;;
  default_windmethod)
    method_args="--wind_method WINDWARD --buffer_width 4 --max_shelterbelt_width 6 --min_shelterbelt_length 20 --min_patch_size 20 --edge_size 4 --min_core_size 1000"
    height=1; opportunities=1; merge_suffixes="_shelter_categories.tif _shelter_distances.tif _opportunities.tif" ;;
  more_windmethod)
    method_args="--wind_method WINDWARD --buffer_width 5 --max_shelterbelt_width 7 --min_shelterbelt_length 15 --min_patch_size 15 --edge_size 5 --min_core_size 2000 --wind_threshold 15"
    height=0; opportunities=0; merge_suffixes="_shelter_categories.tif" ;;
  default_percentmethod)
    method_args="--buffer_width 4 --max_shelterbelt_width 6 --min_shelterbelt_length 20 --min_patch_size 20 --edge_size 4 --min_core_size 1000"
    height=0; opportunities=0; merge_suffixes="_shelter_categories.tif" ;;
  *) echo "Unknown or missing method: '$method'"; exit 1 ;;
esac

BASE=/scratch/xe2/cb8590/gch_v2_ag_indices
input_dir=${BASE}/inputs_${method}/${region}
merged_dir=${BASE}/indices_${method}
outdir=${merged_dir}/${region}
tmpdir="$PBS_JOBFS"
cleanup=${cleanup:-1}
mkdir -p "$merged_dir"

cut_flag=""
[ "$height" = "0" ] && cut_flag="--no_height"
echo "=== [${region}] ${method} cut $([ "$height" = "1" ] && echo "(percent + height)" || echo "(percent only)") ==="
cd "$ANALYSIS"
python gch_cut.py --region "$region" --out_dir "$input_dir" $cut_flag

# Skip cleanly if the region had no GCH-covered tiles (e.g. offshore-only).
if [ ! -d "${input_dir}/percent" ] || [ -z "$(ls -A ${input_dir}/percent 2>/dev/null)" ]; then
    echo "[${region}] no cut tiles — nothing to do"; exit 0
fi

height_arg=""
[ "$height" = "1" ] && height_arg="--height_dir ${input_dir}/height"
opp_flag=""
[ "$opportunities" = "1" ] && opp_flag="--opportunities"

echo "=== [${region}] indices (${method}) ==="
echo "method_args: $method_args"
cd "$INDICES"
python all_indices.py "${input_dir}/percent" --outdir "$outdir" --tmpdir "$tmpdir" \
    --param_stub "$region" $height_arg \
    --cover_threshold 1 --crop_pixels 50 --distance_threshold 20 \
    $method_args $opp_flag \
    --save_gpkg --save_patch_csv

echo "=== [${region}] merge (${merge_suffixes}) ==="
cd "$CLASSIF"
for suf in $merge_suffixes; do
    if ls ${outdir}/*${suf} >/dev/null 2>&1; then
        python merge_tifs.py "$outdir" --suffix "$suf" --subdir '' --tmpdir "$tmpdir" --crs EPSG:3857 --dont_reproject
    fi
done
python -c "from shelterbelts.indices.patch_metrics import combine_patch_metrics_csvs; combine_patch_metrics_csvs('$outdir', output_csv='${merged_dir}/${region}_patch_metrics.csv')"
cd "$ANALYSIS"
python -c "from gch_prep import combine_centrelines; combine_centrelines('$outdir', '${merged_dir}/${region}_centrelines.gpkg')"

if [ "$cleanup" = "1" ]; then
    # Only delete once the merged region deliverables exist, so a failed merge never loses data.
    # Check the region's primary output (first merge_suffix), since not every method merges
    # shelter_categories.tif.
    primary_suf=$(echo $merge_suffixes | awk '{print $1}')
    primary_stem=$(basename "$primary_suf" .tif)
    if [ -f "${merged_dir}/${region}_merged${primary_stem}.tif" ] \
       && [ -f "${merged_dir}/${region}_patch_metrics.csv" ]; then
        echo "=== [${region}] cleanup per-tile intermediates (keep merged region outputs) ==="
        rm -rf "$input_dir" "$outdir"   # inputs (percent/height) + all per-tile outputs; merged kept in parent
    else
        echo "=== [${region}] merge outputs missing — skipping cleanup to preserve data ==="
    fi
fi
echo "=== [${region}] ${method} DONE ==="
